# Configuración del Motor de Hipótesis Biomédicas (v2)
# Copia este archivo a .env y ajusta según tu entorno.

# --- Proveedor de IA local ---
# ollama | openai_compat
LLM_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
# OpenAI-compatible (LM Studio, llama.cpp, etc.)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed

# Modelo principal y modelos de respaldo (separados por coma)
LLM_MODEL=llama3
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
LLM_TIMEOUT=180

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- Rutas (relativas al backend) ---
KNOWLEDGE_DIR=knowledge
DATA_DIR=data

# --- Cerebro / Aprendizaje ---
ENABLE_MEMORY=true

# --- Logs ---
LOG_LEVEL=INFO
